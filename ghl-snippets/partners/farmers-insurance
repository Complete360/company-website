}
.fad-headshot-icon { font-size: 18px; color: #94a3b8; }
.fad-headshot-label {
  font-size: 5.5px; font-weight: 700; text-transform: uppercase;
  letter-spacing: 0.05em; color: #64748b; text-align: center;
