<script>
/* ─── 3D CAROUSEL ─── */
const CARD_DATA = [
  { label: '📱 Mobile Ad — Weather Channel' },
  { label: '📺 CTV Video Ad — Streaming TV' },
];
const TOTAL = CARD_DATA.length;
let active = 0;
let autoTimer = null;

function posClass(cardIdx, activeIdx) {
  const diff = (cardIdx - activeIdx + TOTAL) % TOTAL;
  if (diff === 0) return 'pos-center';
  if (diff === 1) return 'pos-right';
  if (diff === TOTAL - 1) return 'pos-left';
  return diff < TOTAL / 2 ? 'pos-hidden-right' : 'pos-hidden-left';
}
function updateCarousel() {
  document.querySelectorAll('.c-card').forEach((card, i) => {
    card.className = card.className.replace(/pos-\S+/g, '').trim();
    card.classList.add(posClass(i, active));
  });
  document.querySelectorAll('.c-dot').forEach((d, i) => d.classList.toggle('active', i === active));
  document.getElementById('carouselBadge').textContent = CARD_DATA[active].label;
}
function carouselGo(i)  { active = i; updateCarousel(); resetAuto(); }
function carouselNext() { active = (active + 1) % TOTAL; updateCarousel(); resetAuto(); }
function carouselPrev() { active = (active - 1 + TOTAL) % TOTAL; updateCarousel(); resetAuto(); }
function carouselClick(i) { if (i !== active) carouselGo(i); }
function resetAuto() { clearInterval(autoTimer); autoTimer = setInterval(carouselNext, 4500); }
updateCarousel();
autoTimer = setInterval(carouselNext, 4500);

(function() {
  const el = document.getElementById('carouselScene');
  let sx = 0;
  el.addEventListener('touchstart', e => { sx = e.touches[0].clientX; }, { passive: true });
  el.addEventListener('touchend', e => {
    const dx = e.changedTouches[0].clientX - sx;
    if (Math.abs(dx) > 40) dx < 0 ? carouselNext() : carouselPrev();
  });
})();


/* ─── PRICING: COST-SHARE TOGGLE ─── */
let isCS = false;
const PRICES = {
  p0: { full: '1,051.20', cs: '525.60', fullPeriod: 'One-time upfront payment · 48,000 total impressions', csPeriod: 'After 50% Farmers reimbursement · 48,000 total impressions', csEff: 'You pay approx. $525.60 out of pocket' },
  p1: { full: '1,839.60', cs: '919.80', fullPeriod: 'One-time upfront payment · 96,000 total impressions', csPeriod: 'After 50% Farmers reimbursement · 96,000 total impressions', csEff: 'You pay approx. $919.80 out of pocket' },
};

function setCS(cs) {
  isCS = cs;
  document.getElementById('seg-standard').classList.toggle('seg-active', !isCS);
  document.getElementById('seg-costshare').classList.toggle('seg-active', isCS);

  const grid = document.getElementById('pricingGrid');
  grid.classList.toggle('pricing-costshare-active', isCS);

  const hint = document.getElementById('csToggleHint');
  hint.textContent = isCS
    ? '✓ Showing estimated out-of-pocket cost after 50% Farmers co-op reimbursement'
    : 'Toggle to see your estimated out-of-pocket cost after Farmers reimbursement';
  hint.style.color = isCS ? 'var(--green)' : '';
  hint.style.fontWeight = isCS ? '600' : '';

  // 6-month
  document.getElementById('p0-amount').textContent    = isCS ? PRICES.p0.cs   : PRICES.p0.full;
  document.getElementById('p0-original').innerHTML    = isCS ? '$1,051.20 full price' : '&nbsp;';
  document.getElementById('p0-effective').textContent = isCS ? PRICES.p0.csEff : '';
  document.getElementById('p0-period').textContent    = isCS ? PRICES.p0.csPeriod : PRICES.p0.fullPeriod;

  // 12-month
  document.getElementById('p1-amount').textContent    = isCS ? PRICES.p1.cs   : PRICES.p1.full;
  document.getElementById('p1-original').innerHTML    = isCS ? '$1,839.60 full price' : '&nbsp;';
  document.getElementById('p1-effective').textContent = isCS ? PRICES.p1.csEff : '';
  document.getElementById('p1-period').textContent    = isCS ? PRICES.p1.csPeriod : PRICES.p1.fullPeriod;

  equalizeCardRows();
}


/* ─── EQUALIZE CORRESPONDING ROW HEIGHTS ACROSS THE TWO PRICE CARDS ─── */
function equalizeCardRows() {
  const rowClasses = [
    'pc-row-eligible', 'pc-row-format', 'pc-row-title', 'pc-row-desc',
    'pc-row-csband', 'pc-row-original', 'pc-row-price',
    'pc-row-effective', 'pc-row-period'
  ];
  rowClasses.forEach(cls => {
    const rows = document.querySelectorAll('.' + cls);
    if (rows.length < 2) return;
    // Reset first so we measure natural heights
    rows.forEach(r => r.style.minHeight = '');
    const max = Math.max(...Array.from(rows).map(r => r.offsetHeight));
    rows.forEach(r => r.style.minHeight = max + 'px');
  });
}

window.addEventListener('load',   equalizeCardRows);
window.addEventListener('resize', () => {
  // Reset then re-equalize on resize
  document.querySelectorAll('[class*="pc-row-"]').forEach(r => r.style.minHeight = '');
  equalizeCardRows();
});


/* ─── FAQ ─── */
function toggleFaq(el) {
  const item = el.parentElement;
  const was = item.classList.contains('open');
  document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
  if (!was) item.classList.add('open');
}


/* ─── SCROLL ANIMATIONS ─── */
const io = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (!entry.isIntersecting) return;
    const el = entry.target;
    const siblings = Array.from(el.parentElement.children);
    setTimeout(() => el.classList.add('visible'), 80 * siblings.indexOf(el));
    io.unobserve(el);
  });
}, { threshold: 0.12 });
document.querySelectorAll('.fade-up').forEach(el => io.observe(el));


/* ─── CREATIVE PROCESS REVEAL ─── */
(function () {
  const steps = document.querySelectorAll('.cp-step');
  if (!steps.length) return;
  const revealIO = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      entry.target.classList.toggle('revealed', entry.isIntersecting);
    });
  }, { threshold: 0.35 });
  steps.forEach(step => revealIO.observe(step));
})();
</script>

