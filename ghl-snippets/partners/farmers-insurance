<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Farmers Insurance Geo-Fencing Ads | Complete360</title>
  
<style>
/* ============================
   C360 BRAND VARIABLES
============================ */
:root {
  --navy:        #122078;
  --navy-dark:   #0d1654;
  --navy-mid:    #1a2e8a;
  --green:       #127825;
  --green-dark:  #0e5e1d;
  --green-glow:  rgba(18,120,37,0.15);
  --green-light: #EAF3DE;
  --blue-light:  #E6F1FB;
  --white:       #FFFFFF;
  --off-white:   #F1EFE8;
  --gray-light:  #E2E8F4;
  --gray-text:   #6B7A9D;
  --body-text:   #0F1F5E;
  --farmers-red: #CC0000;
  --farmers-red-light: rgba(204,0,0,0.08);
  --font-head:   var(--headlinefont, 'Poppins'), sans-serif;
  --font-body:   var(--contentfont, 'Poppins'), sans-serif;
  --radius:      14px;
  --radius-lg:   22px;
  --shadow:      0 8px 32px rgba(18,32,120,0.10);
  --shadow-lg:   0 20px 60px rgba(18,32,120,0.16);
  --transition:  all 0.3s cubic-bezier(0.4,0,0.2,1);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html, body { margin: 0 !important; padding: 0 !important; width: 100%; }
html { scroll-behavior: smooth; }
body {
  font-family: var(--font-body);
  color: var(--body-text);
  background: var(--white);
  line-height: 1.65;
  overflow-x: hidden;
}
#hero { margin-top: 0 !important; }
img { max-width: 100%; display: block; }
a { text-decoration: none; color: inherit; }
h1, h2, h3, h4 { font-family: var(--font-head); line-height: 1.2; color: var(--navy); }
h1 { font-size: clamp(2rem, 4.5vw, 3.2rem); font-weight: 800; }
h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); font-weight: 700; }
h3 { font-size: clamp(1.05rem, 2vw, 1.3rem); font-weight: 700; }
h4 { font-size: 1.05rem; font-weight: 600; }
p  { font-size: 1rem; font-weight: 400; color: var(--gray-text); }
.label {
  font-size: 0.72rem; font-weight: 700;
  letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--green);
}
.container { max-width: 1160px; margin: 0 auto; padding: 0 24px; }
section { padding: 88px 0; }
.section-header { text-align: center; max-width: 680px; margin: 0 auto 56px; }
.section-header .label { margin-bottom: 12px; }
.section-header h2 { margin-bottom: 16px; }
.section-header p { font-size: 1.05rem; }

/* ── BUTTONS ── */
.btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 14px 32px; border-radius: 50px;
  font-family: var(--font-body); font-size: 0.95rem; font-weight: 600;
  cursor: pointer; border: 2px solid transparent;
  transition: var(--transition); text-decoration: none;
}
.btn-primary { background: var(--green); color: var(--white); }
.btn-primary:hover { background: var(--green-dark); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(18,120,37,0.35); }
.btn-outline { background: transparent; border-color: var(--navy); color: var(--navy); }
.btn-outline:hover { background: var(--navy); color: var(--white); border-color: var(--navy); transform: translateY(-2px); }
.btn-navy { background: var(--navy); color: var(--white); }
.btn-navy:hover { background: var(--navy-dark); transform: translateY(-2px); box-shadow: var(--shadow); }
.btn-white {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--white); color: var(--green-dark);
  border: 2px solid var(--white); padding: 14px 36px;
  border-radius: 50px; font-weight: 700; font-size: 0.95rem;
  transition: var(--transition); cursor: pointer; text-decoration: none;
}
.btn-white:hover { background: transparent; color: var(--white); transform: translateY(-2px); }

/* ── SCROLL ANIMATIONS ── */
.fade-up { opacity: 0; transform: translateY(28px); transition: opacity .6s ease, transform .6s ease; }
.fade-up.visible { opacity: 1; transform: translateY(0); }

/* ============================
   HERO
============================ */
#hero {
  background: linear-gradient(160deg, #ffffff 0%, #eef3ff 40%, #f4f8ff 100%);
  padding: 52px 0 48px;
  overflow: hidden; position: relative;
  border-bottom: 1px solid #dce6f5;
}
#hero::before {
  content: ''; position: absolute; inset: 0;
  background-image: linear-gradient(rgba(18,32,120,0.035) 1px, transparent 1px),
                    linear-gradient(90deg, rgba(18,32,120,0.035) 1px, transparent 1px);
  background-size: 48px 48px; pointer-events: none;
}
#hero::after {
  content: ''; position: absolute; top: -180px; right: -180px;
  width: 700px; height: 700px; border-radius: 50%;
  background: radial-gradient(circle, rgba(18,120,37,0.07) 0%, transparent 65%);
  pointer-events: none;
}

/* Farmers co-op banner — lives below hero stats */
.farmers-alert {
  position: relative; z-index: 2;
  background: rgba(204,0,0,0.05);
  border: 1px solid rgba(204,0,0,0.18);
  border-radius: 10px;
  padding: 10px 16px;
  display: flex; align-items: center; gap: 14px;
  margin-top: auto;
  max-width: 100%;
}
.farmers-alert-badge {
  background: var(--farmers-red); color: var(--white);
  font-size: 0.65rem; font-weight: 800; letter-spacing: 0.1em;
  text-transform: uppercase; padding: 4px 10px; border-radius: 6px;
  white-space: nowrap; flex-shrink: 0;
}
.farmers-alert-text {
  font-size: 0.82rem; color: var(--body-text); font-weight: 500; line-height: 1.4;
}
.farmers-alert-text strong { color: var(--navy); }

.hero-inner {
  display: grid; grid-template-columns: 1fr 1fr;
  align-items: stretch; gap: 64px; position: relative; z-index: 1;
}

.hero-pill {
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(18,120,37,0.07); border: 1px solid rgba(18,120,37,0.22);
  padding: 6px 16px; border-radius: 50px; margin-bottom: 22px;
}

/* Left column — flex column so farmers-alert can be pushed to bottom */
.hero-copy {
  display: flex; flex-direction: column; justify-content: flex-start;
}
.hero-pill .dot { width: 7px; height: 7px; background: var(--green); border-radius: 50%; animation: blink 2s infinite; }
@keyframes blink { 0%,100%{opacity:1;transform:scale(1);} 50%{opacity:0.4;transform:scale(1.4);} }
.hero-pill span { font-size: 0.76rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--green); }

#hero h1 { color: var(--navy); margin-bottom: 18px; }
#hero h1 em { color: var(--green); font-style: normal; }
.hero-sub { color: var(--gray-text); font-size: 1.05rem; margin-bottom: 32px; max-width: 480px; }

/* Cost share callout box */
.hero-costshare-box {
  background: rgba(18,120,37,0.12); border: 1px solid rgba(61,216,112,0.3);
  border-radius: 12px; padding: 18px 22px; margin-bottom: 32px; max-width: 480px;
}
.hero-costshare-box .cs-headline {
  font-family: var(--font-head); font-size: 1rem; font-weight: 700;
  color: #fff; margin-bottom: 6px; display: flex; align-items: center; gap: 8px;
}
.hero-costshare-box .cs-headline span { font-size: 1.1rem; }
.hero-costshare-box .cs-line {
  font-size: 0.85rem; color: rgba(255,255,255,0.65); line-height: 1.55;
}
.hero-costshare-box .cs-line strong { color: #3dd870; }

.hero-btns { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 20px; }

.hero-stats { display: flex; gap: 24px; padding-top: 16px; border-top: 1px solid rgba(18,32,120,0.1); }
.stat-num { font-family: var(--font-head); font-size: 1.8rem; font-weight: 800; color: var(--green); line-height: 1; }
.stat-lbl { font-size: 0.76rem; color: var(--gray-text); margin-top: 4px; }

/* ── AD PREVIEW CAROUSEL (right col) ── */
.carousel-wrap {
  position: relative; z-index: 1;
  display: flex; flex-direction: column;
  align-items: center; gap: 0;
}

/* "Live Ad Preview" header */
.carousel-header {
  width: 100%; text-align: center; margin-bottom: 20px;
}
.carousel-header .ch-label {
  display: inline-flex; align-items: center; gap: 6px;
  background: rgba(18,32,120,0.05); border: 1px solid rgba(18,32,120,0.12);
  padding: 6px 18px; border-radius: 50px;
  font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em;
  text-transform: uppercase; color: var(--gray-text);
}
.carousel-header .ch-label-badge {
  background: rgba(18,120,37,0.25); border: 1px solid rgba(61,216,112,0.35);
  color: #3dd870; padding: 2px 8px; border-radius: 50px;
  font-size: 0.63rem; font-weight: 800; letter-spacing: 0.08em;
}

.carousel-label {
  position: relative; z-index: 20;
  text-align: center; margin-bottom: 18px;
  pointer-events: none;
}
.carousel-label .badge {
  display: inline-flex; align-items: center; gap: 6px;
  background: rgba(18,120,37,0.08); border: 1px solid rgba(18,120,37,0.25);
  padding: 6px 16px; border-radius: 50px;
  font-size: 0.76rem; font-weight: 700; letter-spacing: 0.08em;
  text-transform: uppercase; color: var(--green);
}

.carousel-scene {
  width: 100%; height: 520px;
  perspective: 1100px;
  position: relative;
  display: flex; align-items: center; justify-content: center;
  isolation: isolate;
}
.c-card {
  position: absolute; border-radius: 18px; overflow: hidden;
  cursor: pointer;
  transition: all 0.6s cubic-bezier(0.4,0,0.2,1);
  user-select: none; will-change: transform, opacity;
}
.c-card.pos-center    { transform: translateX(0)     rotateY(0deg)   scale(1);    z-index: 10; opacity: 1; box-shadow: 0 24px 64px rgba(0,0,0,.5), 0 0 0 2px rgba(18,120,37,.5), 0 0 40px rgba(18,120,37,.2); }
.c-card.pos-left      { transform: translateX(-200px) rotateY(30deg)  scale(0.82); z-index: 5;  opacity: 0.6; box-shadow: 0 12px 32px rgba(0,0,0,.4); }
.c-card.pos-right     { transform: translateX(200px)  rotateY(-30deg) scale(0.82); z-index: 5;  opacity: 0.6; box-shadow: 0 12px 32px rgba(0,0,0,.4); }
.c-card.pos-hidden-left  { transform: translateX(-340px) rotateY(45deg)  scale(0.6);  z-index: 1;  opacity: 0; pointer-events: none; }
.c-card.pos-hidden-right { transform: translateX(340px)  rotateY(-45deg) scale(0.6);  z-index: 1;  opacity: 0; pointer-events: none; }
.c-card--mobile  { width: 235px; }
.c-card--ctv     { width: 420px; }
.c-card-img-wrap { width: 100%; overflow: hidden; display: flex; align-items: center; justify-content: center; }
.c-card--mobile .c-card-img-wrap { aspect-ratio: 3/4; background: var(--navy); }
.c-card--ctv    .c-card-img-wrap { aspect-ratio: 16/9; background: #0a0a0a; }
.c-card-img-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }

/* Placeholder overlay — swap hint for Jared */
.c-card-placeholder {
  position: absolute; inset: 0; display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 10px;
  background: rgba(18,32,120,0.82); backdrop-filter: blur(2px);
  pointer-events: none;
}
.c-card-placeholder .ph-icon { font-size: 2rem; }
.c-card-placeholder .ph-text {
  font-family: var(--font-head); font-size: 0.72rem; font-weight: 700;
  color: rgba(255,255,255,0.5); text-align: center; letter-spacing: 0.06em;
  text-transform: uppercase; line-height: 1.5;
  border: 1px dashed rgba(255,255,255,0.2); padding: 8px 14px; border-radius: 8px;
}

.c-card-cap {
  background: rgba(18,32,120,0.93); backdrop-filter: blur(8px);
  padding: 12px 16px; display: flex; align-items: center; gap: 10px;
}
.c-card-cap .cap-icon { font-size: 1.2rem; flex-shrink: 0; }
.c-card-cap .cap-text { font-family: var(--font-head); font-size: 0.82rem; font-weight: 700; color: var(--white); line-height: 1.3; }
.c-card-cap .cap-text span { display: block; font-size: 0.7rem; font-weight: 500; color: rgba(255,255,255,0.52); margin-top: 2px; }

.carousel-controls {
  display: flex; flex-direction: column; align-items: center; gap: 12px;
  position: relative; z-index: 30;
  margin-top: 20px;
}
.carousel-arrows { display: flex; gap: 12px; position: relative; }
.c-arrow {
  width: 42px; height: 42px; border-radius: 50%;
  background: rgba(18,32,120,0.08); border: 1px solid rgba(18,32,120,0.18);
  color: var(--navy); font-size: 1.1rem; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: var(--transition); backdrop-filter: blur(8px);
}
.c-arrow:hover { background: var(--green); border-color: var(--green); transform: scale(1.1); }
.carousel-dots { display: flex; gap: 8px; position: relative; }
.c-dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(18,32,120,0.2); cursor: pointer; transition: all 0.3s; border: none; padding: 0; }
.c-dot.active { background: #3dd870; width: 26px; border-radius: 4px; }

/* ============================
   TRUST BAR
============================ */
.fi-trust-bar {
  background: #fff;
  border-bottom: 1px solid #e5e3dc;
}
.fi-trust-bar-inner {
  display: flex; align-items: stretch;
  justify-content: center; flex-wrap: wrap;
}
.fi-trust-pill {
  display: flex; align-items: center; gap: 12px;
  padding: 18px 26px; border-right: 1px solid #e5e3dc;
  flex: 1; min-width: 190px; transition: background 0.18s;
}
.fi-trust-pill:last-child { border-right: none; }
.fi-trust-pill:hover { background: var(--blue-light); }
.fi-trust-pill-icon {
  width: 38px; height: 38px; background: var(--blue-light);
  border-radius: 9px; display: flex; align-items: center;
  justify-content: center; font-size: 16px; flex-shrink: 0;
}
.fi-trust-pill-icon.red-bg { background: var(--farmers-red-light); }
.fi-trust-pill-text strong {
  display: block; font-family: var(--font-head);
  font-size: 13px; font-weight: 700; color: var(--body-text); line-height: 1.2;
}
.fi-trust-pill-text span { font-size: 11.5px; color: var(--gray-text); }

/* ============================
   WHAT IS COST-SHARE
============================ */
#cost-share { background: var(--off-white); }
.cs-explainer-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 56px; align-items: center;
}
.cs-explainer-left h2 { margin-bottom: 18px; }
.cs-explainer-left p { font-size: 1.02rem; line-height: 1.75; margin-bottom: 16px; }
.cs-explainer-left p:last-of-type { margin-bottom: 0; }

/* Savings calculator highlight */
.cs-savings-box {
  background: var(--white); border: 2px solid var(--green);
  border-radius: var(--radius-lg); padding: 28px 24px;
  box-shadow: 0 8px 32px rgba(18,120,37,0.1);
}
.cs-savings-box .csb-label {
  font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em;
  text-transform: uppercase; color: var(--green); margin-bottom: 16px;
  display: flex; align-items: center; gap: 6px;
}
.cs-package-row {
  display: flex; flex-direction: column; gap: 14px;
}
.cs-pkg {
  background: var(--off-white); border-radius: var(--radius);
  padding: 18px 20px;
}
.cs-pkg-name {
  font-family: var(--font-head); font-size: 0.85rem; font-weight: 700;
  color: var(--navy); margin-bottom: 12px;
}
.cs-pkg-prices {
  display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
}
.cs-full-price {
  font-family: var(--font-head); font-size: 1.1rem; font-weight: 500;
  color: var(--gray-text); text-decoration: line-through; text-decoration-color: rgba(107,122,157,0.6);
}
.cs-arrow-icon { color: var(--green); font-size: 1rem; font-weight: 700; }
.cs-your-price {
  font-family: var(--font-head); font-size: 1.45rem; font-weight: 800; color: var(--green);
}
.cs-your-price-label {
  font-size: 0.72rem; font-weight: 600; color: var(--green);
  background: var(--green-light); border-radius: 50px; padding: 2px 10px;
}
.cs-savings-note {
  margin-top: 16px; font-size: 0.8rem; color: var(--gray-text); line-height: 1.5;
  padding-top: 14px; border-top: 1px solid var(--gray-light);
}

/* ============================
   HOW IT WORKS
============================ */
#how-it-works { background: var(--white); }
.steps-grid {
  display: grid; grid-template-columns: repeat(4,1fr);
  gap: 24px; position: relative;
}
.steps-grid::before {
  content: ''; position: absolute;
  top: 50px; left: calc(12.5% + 16px); right: calc(12.5% + 16px);
  height: 2px; background: linear-gradient(90deg, var(--green), var(--navy-mid)); z-index: 0;
}
.step-card {
  background: var(--off-white); border-radius: var(--radius-lg);
  padding: 32px 22px; text-align: center;
  box-shadow: var(--shadow); position: relative; z-index: 1;
  transition: var(--transition); border: 1px solid var(--gray-light);
}
.step-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); border-color: var(--green); }
.step-num {
  width: 52px; height: 52px;
  background: linear-gradient(135deg, var(--green), var(--green-dark));
  color: var(--white); border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-head); font-size: 1.3rem; font-weight: 800;
  margin: 0 auto 20px; box-shadow: 0 4px 16px rgba(18,120,37,0.35);
}
.step-card h3 { font-size: 1rem; margin-bottom: 10px; }
.step-card p { font-size: 0.88rem; }

/* ============================
   AD FORMATS
============================ */
#ad-formats { background: var(--off-white); }
.formats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; max-width: 860px; margin: 0 auto; }
.format-card {
  border: 2px solid var(--gray-light); border-radius: var(--radius-lg);
  padding: 36px 28px; transition: var(--transition); position: relative; overflow: hidden;
  background: var(--white);
}
.format-card::before {
  content: ''; position: absolute; top:0; left:0; right:0; height:4px;
  background: linear-gradient(90deg, var(--green), var(--navy));
  transform: scaleX(0); transform-origin: left; transition: transform 0.4s ease;
}
.format-card:hover { border-color: var(--green); box-shadow: var(--shadow-lg); transform: translateY(-4px); }
.format-card:hover::before { transform: scaleX(1); }
.format-icon { width:56px; height:56px; background: var(--green-glow); border-radius:14px; display:flex; align-items:center; justify-content:center; margin-bottom:20px; font-size:1.6rem; }
.format-card h3 { margin-bottom:10px; font-size:1.15rem; }
.format-card p { font-size:0.9rem; margin-bottom:16px; }
.format-tag { display:inline-block; background:var(--off-white); border:1px solid var(--gray-light); border-radius:50px; padding:3px 12px; font-size:0.75rem; font-weight:600; color:var(--navy); margin:3px 2px; }
.flagship-badge { position:absolute; top:18px; right:18px; background:var(--green); color:var(--white); font-size:0.68rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; padding:4px 10px; border-radius:50px; }

/* ============================
   WHAT WE DO FOR YOU
============================ */
#creative-process { background: var(--white); padding: 88px 0; }
.cp-track {
  position: relative; max-width: 800px; margin: 0 auto; padding-left: 56px;
}
.cp-track::before {
  content: ''; position: absolute; left: 20px; top: 8px; bottom: 8px;
  width: 3px; background: linear-gradient(180deg, var(--green) 0%, var(--navy) 100%);
  border-radius: 3px; opacity: 0.18;
}
.cp-step {
  position: relative; padding: 0 0 52px 32px;
  opacity: 0; transform: translateY(36px);
  transition: opacity 0.55s ease, transform 0.55s ease;
}
.cp-step:last-child { padding-bottom: 0; }
.cp-step.revealed { opacity: 1; transform: translateY(0); }
.cp-step:nth-child(2).revealed { transition-delay: 0.08s; }
.cp-step:nth-child(3).revealed { transition-delay: 0.16s; }
.cp-step:nth-child(4).revealed { transition-delay: 0.24s; }
.cp-step:nth-child(5).revealed { transition-delay: 0.32s; }
.cp-dot {
  position: absolute; left: -44px; top: 4px;
  width: 42px; height: 42px; border-radius: 50%;
  background: var(--white); border: 3px solid var(--gray-light);
  display: flex; align-items: center; justify-content: center;
  font-size: 1.3rem; box-shadow: var(--shadow);
  transition: border-color 0.4s, background 0.4s, box-shadow 0.4s; z-index: 1;
}
.cp-step.revealed .cp-dot { border-color: var(--green); background: var(--green-light); box-shadow: 0 4px 16px rgba(18,120,37,0.2); }
.cp-step-num {
  position: absolute; top: -6px; right: -6px;
  width: 18px; height: 18px; border-radius: 50%;
  background: var(--green); color: var(--white);
  font-family: var(--font-head); font-size: 0.6rem; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
}
.cp-card {
  background: var(--off-white); border: 2px solid var(--gray-light);
  border-radius: var(--radius-lg); padding: 28px 32px; box-shadow: var(--shadow);
  transition: border-color 0.4s, box-shadow 0.4s;
}
.cp-step.revealed .cp-card { border-color: rgba(18,120,37,0.25); box-shadow: 0 8px 32px rgba(18,120,37,0.09); }
.cp-card h3 { font-size: 1.1rem; margin-bottom: 8px; }
.cp-card p  { font-size: 0.92rem; line-height: 1.72; }

/* ============================
   PRICING
============================ */
#pricing { background: var(--off-white); overflow: hidden; }

/* Cost-share toggle */
.pricing-toggle {
  display: flex; align-items: center; justify-content: center;
  flex-direction: column; gap: 10px; margin-bottom: 52px;
}
.pricing-toggle-pill {
  display: inline-flex; align-items: center;
  background: #f0ede6; border-radius: 100px;
  padding: 5px; gap: 4px; border: 1px solid #e2ddd4;
}
.toggle-seg {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 10px 24px; border-radius: 100px;
  font-family: var(--font-head); font-size: 14px; font-weight: 600;
  cursor: pointer; border: none; background: transparent;
  color: var(--gray-text); transition: all 0.25s cubic-bezier(0.4,0,0.2,1);
  white-space: nowrap; line-height: 1;
}
.toggle-seg .seg-badge {
  font-size: 9px; font-weight: 700; letter-spacing: 0.08em;
  text-transform: uppercase; padding: 2px 8px;
  border-radius: 100px; background: var(--green-glow);
  border: 1px solid rgba(18,120,37,0.2); color: var(--green);
  line-height: 1.4;
}
.toggle-seg.seg-active {
  background: var(--navy); color: #fff;
  box-shadow: 0 4px 14px rgba(18,32,120,0.28);
}
.toggle-seg.seg-active .seg-badge {
  background: rgba(61,216,112,0.18);
  border-color: rgba(61,216,112,0.35);
  color: #3dd870;
}
.toggle-seg:hover:not(.seg-active) { background: rgba(18,32,120,0.07); color: var(--navy); }
.pricing-toggle-hint {
  font-size: 12px; color: var(--gray-text); font-weight: 500;
  background: var(--white); border: 1px solid var(--gray-light);
  padding: 6px 16px; border-radius: 50px;
}

/* Format toggle inside pricing */
.format-toggle-row {
  display: flex; align-items: center; justify-content: center;
  gap: 10px; margin-bottom: 40px;
}
.format-toggle-label {
  font-size: 12.5px; font-weight: 600; color: var(--gray-text);
  text-transform: uppercase; letter-spacing: 0.08em;
}
.format-toggle-pill {
  display: inline-flex; align-items: center;
  background: var(--white); border-radius: 100px;
  padding: 4px; gap: 3px; border: 1px solid var(--gray-light);
}
.ftoggle-seg {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 8px 18px; border-radius: 100px;
  font-family: var(--font-head); font-size: 13px; font-weight: 600;
  cursor: pointer; border: none; background: transparent;
  color: var(--gray-text); transition: all 0.22s;
  white-space: nowrap;
}
.ftoggle-seg.seg-active {
  background: var(--navy); color: #fff;
  box-shadow: 0 3px 10px rgba(18,32,120,0.22);
}
.ftoggle-seg:hover:not(.seg-active) { background: var(--off-white); color: var(--navy); }

/* pc-row: structural wrappers used for JS height equalization */
.pc-row { width: 100%; }
.pc-row-eligible, .pc-row-format { display: flex; justify-content: center; }
.pc-row-title, .pc-row-desc, .pc-row-csband,
.pc-row-original, .pc-row-price, .pc-row-effective,
.pc-row-period { display: flex; flex-direction: column; align-items: center; justify-content: center; }

/* Card grid — two pricing cards + CTA */
.pricing-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 24px;
  align-items: start;
}

/* The two main cards sit in a sub-grid so rows can be equalized */
.pricing-two-cards {
  display: contents;
}

.price-card {
  border: 2px solid var(--gray-light); border-radius: var(--radius-lg);
  padding: 36px 26px; text-align: center;
  transition: var(--transition); position: relative; display: flex;
  flex-direction: column; background: var(--white);
}
.price-card.featured { background: var(--navy); border-color: var(--green); transform: scale(1.04); box-shadow: var(--shadow-lg); }
.price-card.featured h3 { color: var(--white); }
.price-card.featured > p { color: rgba(255,255,255,.65); }
.price-card.featured .price-features li { color: rgba(255,255,255,.9); }

.price-badge { position: absolute; top: -14px; left: 50%; transform: translateX(-50%); background: var(--green); color: var(--white); font-size: .7rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; padding: 5px 16px; border-radius: 50px; white-space: nowrap; }
.card-format-pill { display: inline-flex; align-items: center; gap: 6px; background: var(--green-glow); border: 1px solid rgba(18,120,37,.22); color: var(--green); font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; padding: 3px 10px; border-radius: 50px; margin-bottom: 14px; }
.price-card.featured .card-format-pill { color: #3dd870; background: rgba(18,120,37,.22); border-color: rgba(18,120,37,.4); }

.price-card h3 { margin-bottom: 8px; }
.price-card > p { font-size: .88rem; margin-bottom: 16px; }

.price-main-row { display: flex; align-items: flex-end; gap: 2px; justify-content: center; margin-bottom: 4px; }
.price-currency { font-family: var(--font-head); font-size: 1.2rem; font-weight: 700; color: var(--navy); padding-bottom: 8px; }
.price-card.featured .price-currency { color: rgba(255,255,255,0.7); }
.price-amount { font-family: var(--font-head); font-size: 2.5rem; font-weight: 800; color: var(--navy); line-height: 1; transition: opacity 0.3s; }
.price-card.featured .price-amount { color: var(--white); }
.price-original { font-size: .8rem; color: var(--gray-text); text-decoration: line-through; min-height: 18px; margin-bottom: 2px; }
.price-card.featured .price-original { color: rgba(255,255,255,0.35); }
.price-effective { font-size: .78rem; color: var(--green); font-weight: 600; min-height: 18px; margin-bottom: 2px; }
.price-card.featured .price-effective { color: #3dd870; }
.price-period { font-size: .8rem; color: var(--gray-text); margin-bottom: 20px; }
.price-card.featured .price-period { color: rgba(255,255,255,0.5); }

/* Cost-share savings highlight band */
.cs-savings-band {
  display: none; align-items: center; justify-content: center; gap: 8px;
  background: rgba(18,120,37,0.1); border: 1px solid rgba(18,120,37,0.25);
  border-radius: 8px; padding: 8px 12px; margin-bottom: 14px;
  font-size: 0.78rem; font-weight: 700; color: var(--green);
}
.price-card.featured .cs-savings-band {
  background: rgba(61,216,112,0.12); border-color: rgba(61,216,112,0.3); color: #3dd870;
}
.pricing-costshare-active .cs-savings-band { display: flex; }

.price-divider { height: 1px; background: var(--gray-light); margin-bottom: 22px; }
.price-card.featured .price-divider { background: rgba(255,255,255,.15); }
.price-features { list-style: none; text-align: left; margin-bottom: 28px; display: flex; flex-direction: column; gap: 11px; flex: 1; }
.price-features li { display: flex; align-items: center; gap: 10px; font-size: .88rem; color: var(--body-text); }
.price-features li::before { content: '✓'; width: 20px; height: 20px; min-width: 20px; background: var(--green-glow); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: .68rem; font-weight: 800; color: var(--green); }
.price-card.featured .price-features li::before { background: rgba(18,120,37,.25); color: #3dd870; }
.price-note { text-align: center; margin-top: 36px; font-size: .88rem; color: var(--gray-text); }

/* Farmers eligible badge on package cards */
.farmers-eligible-tag {
  display: inline-flex; align-items: center; gap: 5px;
  background: var(--farmers-red-light); border: 1px solid rgba(204,0,0,0.2);
  color: var(--farmers-red); font-size: 0.68rem; font-weight: 700;
  letter-spacing: 0.06em; text-transform: uppercase;
  padding: 3px 10px; border-radius: 50px; margin-bottom: 12px;
}
.price-card.featured .farmers-eligible-tag {
  background: rgba(204,0,0,0.2); border-color: rgba(204,0,0,0.35);
}

/* CTV "Coming soon" card */
.ctv-coming-card {
  border: 2px dashed var(--gray-light); border-radius: var(--radius-lg);
  padding: 36px 26px; text-align: center; background: var(--off-white);
  display: flex; flex-direction: column; align-items: center;
}
.ctv-coming-card .ctv-icon { font-size: 2.4rem; margin-bottom: 16px; }
.ctv-coming-card h3 { margin-bottom: 8px; }
.ctv-coming-card > p { font-size: 0.88rem; margin-bottom: 20px; }
.ctv-coming-badge {
  background: var(--off-white); border: 1px solid var(--gray-light);
  border-radius: 50px; padding: 6px 18px;
  font-size: 0.75rem; font-weight: 700; color: var(--gray-text);
  letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 20px;
}
.ctv-features-preview { list-style: none; text-align: left; width: 100%; margin-bottom: 24px; display: flex; flex-direction: column; gap: 10px; }
.ctv-features-preview li { display: flex; align-items: center; gap: 10px; font-size: .85rem; color: var(--gray-text); }
.ctv-features-preview li::before { content: '↗'; color: var(--gray-text); font-weight: 700; font-size: 0.75rem; }

/* ============================
   TESTIMONIALS
============================ */
#testimonials { background: var(--white); }
.reviews-wrapper { width: 100%; }

/* ============================
   CONTACT
============================ */
#contact {
  background: linear-gradient(135deg, var(--navy) 0%, var(--navy-dark) 100%);
  padding: 80px 0; position: relative; overflow: hidden; text-align: center;
}
#contact::before {
  content: ''; position: absolute; bottom: -150px; left: -150px;
  width: 500px; height: 500px; border-radius: 50%;
  background: radial-gradient(circle, rgba(18,120,37,.14) 0%, transparent 65%);
}
#contact .section-header { position: relative; z-index: 1; }
#contact .section-header h2 { color: var(--white); }
#contact .section-header p  { color: rgba(255,255,255,.65); }

/* Carousel cost-share strip */
.carousel-cs-strip {
  margin-top: 16px; width: 100%;
  background: rgba(18,120,37,0.07);
  border: 1px solid rgba(18,120,37,0.22);
  border-radius: 12px; padding: 14px 18px;
  display: flex; flex-direction: column; gap: 8px;
}
.ccs-row {
  display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
}
.ccs-label {
  font-family: var(--font-head); font-size: 0.72rem; font-weight: 700;
  letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--gray-text); min-width: 72px;
}
.ccs-full {
  font-family: var(--font-head); font-size: 0.88rem; font-weight: 600;
  color: var(--gray-text); text-decoration: line-through;
  text-decoration-color: rgba(107,122,157,0.5);
}
.ccs-arrow { color: #3dd870; font-weight: 700; font-size: 0.9rem; }
.ccs-cs {
  font-family: var(--font-head); font-size: 1rem; font-weight: 800; color: var(--green);
}
.ccs-cs em {
  font-style: normal; font-size: 0.72rem; font-weight: 600;
  color: var(--green-dark); margin-left: 4px; opacity: 0.7;
}
.ccs-divider {
  height: 1px; background: rgba(18,120,37,0.15);
}

/* ============================
   FAQ
============================ */
#faq { background: var(--white); }
.faq-grid { max-width: 780px; margin: 0 auto; display: flex; flex-direction: column; gap: 10px; }
.faq-item { border: 1px solid var(--gray-light); background: var(--white); border-radius: var(--radius); overflow: hidden; transition: var(--transition); }
.faq-item.open { border-color: var(--green); box-shadow: 0 4px 20px rgba(18,120,37,.1); }
.faq-q { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 24px; cursor: pointer; font-family: var(--font-head); font-size: .98rem; font-weight: 600; color: var(--navy); user-select: none; transition: var(--transition); }
.faq-q:hover { background: var(--blue-light); }
.faq-item.open .faq-q { background: var(--green-light); }
.faq-icon { width: 28px; height: 28px; min-width: 28px; background: var(--off-white); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; color: var(--green); transition: transform .3s; line-height: 1; }
.faq-item.open .faq-icon { transform: rotate(45deg); background: var(--green); color: var(--white); }
.faq-a { max-height: 0; overflow: hidden; transition: max-height .4s ease, padding .3s; padding: 0 24px; }
.faq-item.open .faq-a { max-height: 400px; padding: 0 24px 20px; }
.faq-a p { font-size: .93rem; line-height: 1.7; }

/* ============================
   PHONE DEVICE CARDS (card IS the phone)
============================ */
.c-card--phone {
  width: 260px;
  border-radius: 36px !important;
  border: 5px solid #2a2a2a !important;
  background: #111 !important;
  box-shadow: 0 0 0 1px #444, inset 0 0 0 1px rgba(255,255,255,0.04), 0 20px 50px rgba(0,0,0,0.7) !important;
  display: flex; flex-direction: column; overflow: hidden;
}
.c-card--phone.pos-center {
  box-shadow: 0 0 0 2px rgba(18,120,37,.5), 0 0 32px rgba(18,120,37,.18), 0 24px 48px rgba(0,0,0,.4) !important;
}
.ph-bezel-top {
  background: #111; height: 22px;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.ph-camera-dot {
  width: 8px; height: 8px;
  background: #2a2a2a; border-radius: 50%; border: 1px solid #3a3a3a;
}
.ph-screen {
  flex: 1; display: flex; flex-direction: column;
  overflow: hidden; background: #fff;
}
.ph-bezel-bottom {
  background: #111; height: 20px;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.ph-home-pill { width: 60px; height: 4px; background: #3a3a3a; border-radius: 4px; }
.ph-status-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 3px 10px; font-size: 7px; font-weight: 700;
  font-family: var(--font-head); flex-shrink: 0;
}
.ph-status-blue { background: #1a6fa5; color: rgba(255,255,255,0.9); }
.ph-status-dark { background: #111; color: rgba(255,255,255,0.85); }
.ph-time { font-size: 7.5px; }
.ph-status-icons { display: flex; gap: 3px; font-size: 6px; }

/* Weather Channel header */
.ph-header-twc {
  background: linear-gradient(180deg, #1a6fa5 0%, #155f8e 100%);
  padding: 7px 10px 8px; flex-shrink: 0;
}
.ph-twc-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }
.ph-twc-logo { font-size: 7px; font-weight: 700; color: #fff; }
.ph-twc-loc  { font-size: 6.5px; color: rgba(255,255,255,0.7); }
.ph-twc-temp-row { display: flex; align-items: center; gap: 8px; }
.ph-twc-temp { font-family: var(--font-head); font-size: 28px; font-weight: 800; color: #fff; line-height: 1; }
.ph-twc-detail { display: flex; flex-direction: column; gap: 1px; font-size: 7px; color: rgba(255,255,255,0.82); }

/* Fox News header */
.ph-header-fox { background: #111; padding: 7px 10px; flex-shrink: 0; }
.ph-fox-logo { display: flex; align-items: baseline; gap: 4px; margin-bottom: 4px; }
.ph-fox-text { font-family: 'Arial Black',sans-serif; font-size: 13px; font-weight: 900; color: #fff; letter-spacing: 0.04em; }
.ph-fox-news { font-family: 'Arial Black',sans-serif; font-size: 10px; font-weight: 900; color: #f90; letter-spacing: 0.06em; }
.ph-fox-breaking { display: flex; align-items: center; gap: 5px; }
.ph-breaking-tag { background: #cc0000; color: #fff; font-size: 6px; font-weight: 800; letter-spacing: 0.08em; padding: 1px 5px; border-radius: 2px; }
.ph-breaking-text { font-size: 7px; color: rgba(255,255,255,0.7); }

/* Ad zone */
.ph-ad-zone { position: relative; flex-shrink: 0; border-top: 1px solid rgba(0,0,0,0.1); border-bottom: 1px solid rgba(0,0,0,0.1); }
.ph-ad-label {
  position: absolute; top: 3px; right: 5px; z-index: 2;
  font-size: 5px; font-weight: 700; color: rgba(0,0,0,0.35); letter-spacing: 0.08em;
  background: rgba(255,255,255,0.75); padding: 1px 4px; border-radius: 2px;
}

/* Below-ad content */
.ph-app-below { padding: 5px 8px; flex: 1; overflow: hidden; }
.ph-below-label { font-size: 6.5px; font-weight: 700; color: #333; margin-bottom: 3px; text-transform: uppercase; letter-spacing: 0.06em; }
.ph-below-fox  { background: #fafafa; border-top: 2px solid #cc0000; }
.ph-forecast-strip { display: flex; gap: 4px; }
.ph-fc-item { flex: 1; display: flex; flex-direction: column; align-items: center; font-family: var(--font-head); font-size: 6.5px; font-weight: 600; color: #333; gap: 2px; }
.ph-news-teasers { padding: 4px 8px; background: #fafafa; flex-shrink: 0; }
.ph-news-row { display: flex; align-items: center; gap: 6px; padding: 3px 0; border-bottom: 1px solid rgba(0,0,0,0.07); }
.ph-news-row-sm { padding: 2px 0; }
.ph-news-thumb { width: 22px; height: 16px; background: #ddd; border-radius: 2px; flex-shrink: 0; }
.ph-news-snippet { font-size: 6px; color: #444; line-height: 1.3; flex: 1; }

/* Nav bars */
.ph-app-nav { display: flex; flex-shrink: 0; margin-top: auto; border-top: 1px solid rgba(0,0,0,0.12); }
.ph-nav-twc { background: #fff; }
.ph-nav-fox  { background: #111; }
.ph-nav-item { flex: 1; text-align: center; padding: 3px 0; font-size: 8.5px; color: #888; font-family: var(--font-head); }
.ph-nav-fox .ph-nav-item { color: rgba(255,255,255,0.45); }
.ph-nav-item small { display: block; font-size: 5.5px; font-weight: 600; }
.ph-nav-active { color: #1a6fa5 !important; }
.ph-nav-active-fox { color: #f90 !important; }

/* ============================
   TV DEVICE FRAME (CTV cards)
============================ */
.tv-device-wrap {
  width: 100%; display: flex; flex-direction: column; align-items: center;
  padding: 10px 8px 0; flex: 1;
  background: linear-gradient(135deg, #1a1a2e 0%, #0d1654 100%);
}
.tv-device-frame {
  width: 100%; background: #1c1c1c;
  border-radius: 8px 8px 4px 4px;
  border: 5px solid #2d2d2d;
  box-shadow: 0 0 0 1px #444, inset 0 0 0 1px rgba(255,255,255,0.04), 0 8px 24px rgba(0,0,0,0.6);
  overflow: hidden;
}
.tv-device-screen {
  background: #fff; padding: 10px 14px;
  display: flex; flex-direction: column; min-height: 135px;
}
.tv-device-neck { width: 24px; height: 12px; background: linear-gradient(180deg,#2d2d2d,#3a3a3a); margin: 0 auto; }
.tv-device-base { width: 90px; height: 8px; background: linear-gradient(180deg,#3a3a3a,#2d2d2d); border-radius: 0 0 6px 6px; margin: 0 auto 8px; }

/* ============================
   FARMERS AD CARD (HTML recreation)
============================ */
.c-card--mobile .farmers-ad-card {
  width: 100%; height: 100%;
  display: flex; flex-direction: column;
  font-family: 'Arial', sans-serif;
  overflow: hidden; background: #fff;
}
.fad-header {
  background: #cc0000;
